rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownUser(uid) { return signedIn() && request.auth.uid == uid; }
    function userGroup() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId;
    }
    function ownResource() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }
    function ownCreatedResource() {
      return signedIn() && resource.data.createdBy == request.auth.uid;
    }
    function inMyGroup(data) {
      return signedIn()
        && exists(/databases/$(database)/documents/spaces/$(data.groupId)/members/$(request.auth.uid));
    }
    function readableShared() {
      return inMyGroup(resource.data) && resource.data.visibility == 'shared';
    }
    match /users/{userId} { allow read, write: if ownUser(userId); }
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && exists(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)/members/$(request.auth.uid));
      allow update: if signedIn()
        && resource.data.status == 'active'
        && request.resource.data.spaceId == resource.data.spaceId;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
    match /spaces/{spaceId} {
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)));
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if false;
      match /members/{memberId} {
        allow read: if signedIn()
          && (resource.data.userId == request.auth.uid
            || memberId == request.auth.uid
            || exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)));
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow update: if signedIn()
          && memberId == request.auth.uid
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }
    match /{path=**}/members/{memberId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
    }
    match /pushTokens/{tokenId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && inMyGroup(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && inMyGroup(request.resource.data);
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /sentNotifications/{id} { allow read, write: if false; }
    match /{col}/{id} {
      allow read: if signedIn()
        && col in ['diaries','events','todos','expenses','anniversaries']
        && (ownResource() || readableShared());
      allow create: if signedIn()
        && col in ['diaries','events','todos','expenses','anniversaries']
        && request.resource.data.userId == request.auth.uid
        && inMyGroup(request.resource.data);
      allow update: if signedIn()
        && col in ['diaries','events','todos','expenses','anniversaries']
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && inMyGroup(request.resource.data);
      allow delete: if signedIn()
        && col in ['diaries','events','todos','expenses','anniversaries']
        && resource.data.userId == request.auth.uid;
    }
    match /sharedNotes/{id} {
      allow read: if inMyGroup(resource.data);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && inMyGroup(request.resource.data);
      allow update: if ownCreatedResource()
        && request.resource.data.createdBy == request.auth.uid
        && inMyGroup(request.resource.data);
      allow delete: if ownCreatedResource();
    }
  }
}
